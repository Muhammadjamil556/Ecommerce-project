# Copy this file to .env and adjust the values.
NODE_ENV=development
PORT=3000

# The address of the React app. Only this origin may call the API from a browser.
FRONTEND_URL=http://localhost:5173

# Supabase: dashboard > Project Settings > API Keys (and Data API for the URL).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# SECRET. Bypasses Row Level Security. Never commit it, share it or use it in frontend/.
SUPABASE_SECRET_KEY=sb_secret_replace_me
